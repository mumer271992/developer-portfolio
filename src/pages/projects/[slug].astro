---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/projects';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[i - 1],
      next: projects[i + 1],
    },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project: p, prev, next } = Astro.props;
const media = p.media ?? [];

// Optional write-up in src/content/projects/<slug>.md. A file holding only
// comments (the starter template) counts as empty, so the description shows.
const entry = (await getCollection('projects')).find((e) => e.id === p.slug);
const hasWriteUp = !!entry?.body?.replace(/<!--[\s\S]*?-->/g, '').trim();
const WriteUp = hasWriteUp ? (await render(entry!)).Content : null;

// Video posters are plain URLs, so optimize them up front
const posterUrls = new Map<unknown, string>();
for (const m of media) {
  if (m.kind === 'video' && m.poster) {
    posterUrls.set(m, (await getImage({ src: m.poster, width: 1040, format: 'webp' })).src);
  }
}
---

<Layout title={`${p.name} · ${profile.name}`} description={p.description}>
  <Nav />
  <main id="top" class="mx-auto max-w-[1040px] px-4">
    <a href="/#work" class="mt-10 inline-flex items-center gap-2 font-mono text-[0.9rem] text-fg no-underline hover:text-accent">
      {/* The glyph sits low in its box; lift it to line up with the text */}
      <span aria-hidden="true" class="translate-y-[-0.15em] text-[1.5rem] leading-none">←</span> All work
    </a>

    <header class="mt-6 border-b border-line pb-8">
      <span class="font-mono text-[0.72rem] tracking-[0.08em] text-muted uppercase">{p.industry}</span>
      <h1 class="mt-2 text-[2.6rem] md:text-[3.4rem]">{p.name}</h1>
      <p class="mt-2 font-mono text-[0.8125rem] text-ok">{p.org}</p>
      {p.href && (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 rounded-lg border border-line bg-panel px-4 py-2.5 font-mono text-[0.8125rem] text-fg no-underline hover:border-accent"
        >
          Visit live site <span aria-hidden="true" class="text-[1.5rem] leading-none">↗</span>
        </a>
      )}
    </header>

    {media.length > 0 && (
      <div class="mt-8 grid gap-5">
        {media.map((m, i) => {
          const label = media.length > 1 ? `${p.name} screenshot ${i + 1} of ${media.length}` : `${p.name} screenshot`;
          return m.kind === 'video' ? (
            <video
              class="w-full rounded-xl border border-line"
              controls
              muted
              playsinline
              preload="none"
              poster={posterUrls.get(m)}
              aria-label={label}
            >
              <source src={m.src} type={m.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
            </video>
          ) : p.imageFit === 'contain' ? (
            <div class="thumb thumb-logo grid aspect-[16/7] place-items-center rounded-xl border border-line">
              <Image src={m.src} alt={`${p.name} logo`} class="h-auto w-[45%] max-w-[320px] object-contain" />
            </div>
          ) : (
            <Image
              src={m.src}
              alt={label}
              widths={[480, 720, 1040, 1600]}
              sizes="(min-width: 1072px) 1008px, calc(100vw - 32px)"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="h-auto w-full rounded-xl border border-line"
            />
          );
        })}
      </div>
    )}

    <section class="grid gap-8 py-10 md:grid-cols-[1fr_260px]">
      <div class="min-w-0">
        {WriteUp ? (
          <div class="write-up max-w-[65ch] text-muted">
            <WriteUp />
          </div>
        ) : (
          <>
            <h2 class="text-[1.9rem]">About the project</h2>
            <p class="mt-3 max-w-[65ch] text-muted">{p.description}</p>
          </>
        )}
        {p.highlights?.length ? (
          <>
            <h2 class="mt-8 text-[1.9rem]">Highlights</h2>
            <ul class="mt-3 grid max-w-[65ch] list-disc gap-2 pl-5 text-muted marker:text-accent">
              {p.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </>
        ) : null}
      </div>

      <aside>
        <h2 class="font-mono text-[0.72rem] tracking-[0.08em] text-muted uppercase">Tech stack</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {p.tags.map((t) => (
            <span class="rounded-full border border-line bg-panel-2 px-2 py-0.5 font-mono text-[0.72rem] text-fg">{t}</span>
          ))}
        </div>
      </aside>
    </section>

    <nav aria-label="More projects" class="grid gap-3 border-t border-line pt-8 sm:grid-cols-2">
      {prev ? (
        <a href={`/projects/${prev.slug}`} class="rounded-xl border border-line bg-panel p-4 no-underline hover:border-accent">
          <span class="block font-mono text-[0.72rem] text-muted">← Previous</span>
          <span class="mt-1 block font-display text-[1.4rem] text-fg">{prev.name}</span>
        </a>
      ) : <span class="hidden sm:block"></span>}
      {next && (
        <a href={`/projects/${next.slug}`} class="rounded-xl border border-line bg-panel p-4 text-right no-underline hover:border-accent">
          <span class="block font-mono text-[0.72rem] text-muted">Next →</span>
          <span class="mt-1 block font-display text-[1.4rem] text-fg">{next.name}</span>
        </a>
      )}
    </nav>

    <Footer />
  </main>
</Layout>

<style>
  /* Markdown output has no classes, so style its elements to match the page */
  .write-up :global(h2) {
    margin-top: 2rem;
    font-size: 1.9rem;
    color: var(--fg);
  }
  .write-up :global(h2:first-child) {
    margin-top: 0;
  }
  .write-up :global(h3) {
    margin-top: 1.5rem;
    font-size: 1.4rem;
    color: var(--fg);
  }
  .write-up :global(p),
  .write-up :global(ul),
  .write-up :global(ol) {
    margin-top: 0.75rem;
  }
  .write-up :global(ul),
  .write-up :global(ol) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }
  .write-up :global(ul) {
    list-style: disc;
  }
  .write-up :global(ol) {
    list-style: decimal;
  }
  .write-up :global(li::marker) {
    color: var(--accent);
  }
  .write-up :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .write-up :global(a) {
    color: var(--accent);
  }
  .write-up :global(code) {
    font-family: var(--font-jetbrains), monospace;
    font-size: 0.9em;
  }
  .write-up :global(img) {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
  }
</style>
