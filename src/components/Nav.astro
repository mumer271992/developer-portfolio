---
import { profile } from '../data/profile';

const links = [
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="sticky top-0 z-10 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1040px] items-center justify-between gap-4 px-4 py-3">
    <a href="#top" class="font-mono text-[0.8125rem] text-fg no-underline">
      &lt;<span class="text-accent">{profile.shortName}</span> /&gt;
    </a>

    <div class="flex items-center gap-[30px]">
      <ul class="hidden list-none gap-[30px] font-mono text-[0.8125rem] sm:flex">
        {links.map((l) => (
          <li><a class="nav-link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle inline-grid size-8 cursor-pointer place-items-center rounded-lg border border-line bg-panel text-muted transition-colors hover:border-accent hover:text-fg"
        aria-label="Switch color theme"
        title="Switch color theme"
      >
        <svg class="sun size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="moon size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Theme toggle with a ripple from the button
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'light' ? 'dark' : 'light';

    const apply = () => {
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
      btn.classList.remove('spin');
      void btn.offsetWidth;
      btn.classList.add('spin');
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reduce) { apply(); return; }

    const r = btn.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    const t = document.startViewTransition(apply);
    t.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 650, easing: 'cubic-bezier(.4,0,.2,1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
  });

  // Highlight the navbar link for the section in view
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')]
    .map((a) => ({ a, s: document.querySelector<HTMLElement>(a.getAttribute('href')!) }))
    .filter((x): x is { a: HTMLAnchorElement; s: HTMLElement } => !!x.s);

  let ticking = false;
  const update = () => {
    ticking = false;
    const line = innerHeight * 0.35;
    let current: (typeof items)[number] | null = null;
    for (const x of items) if (x.s.getBoundingClientRect().top <= line) current = x;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = items.at(-1) ?? null;
    for (const x of items) {
      const on = x === current;
      x.a.classList.toggle('active', on);
      if (on) x.a.setAttribute('aria-current', 'true');
      else x.a.removeAttribute('aria-current');
    }
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>
